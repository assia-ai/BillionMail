# ============================================
# BillionMail - Configuration pour Coolify
# ============================================
# Copiez ces variables dans les "Environment Variables" de Coolify
# ou utilisez ce fichier comme base pour votre .env

# ============================================
# CONFIGURATION OBLIGATOIRE - À MODIFIER
# ============================================

# Nom de domaine de votre serveur mail (ex: mail.votredomaine.com)
BILLIONMAIL_HOSTNAME=mail.example.com

# Identifiants administrateur (CHANGEZ CES VALEURS!)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=ChangeMe123!

# Chemin d'accès sécurisé au panel (URL: https://votre-ip/SafePath)
SafePath=billionmail

# ============================================
# BASE DE DONNÉES POSTGRESQL
# ============================================
DBNAME=billionmail
DBUSER=billionmail
# Générez un mot de passe fort (32 caractères recommandé)
DBPASS=GENERATE_STRONG_PASSWORD_HERE

# ============================================
# REDIS
# ============================================
# Générez un mot de passe fort (32 caractères recommandé)
REDISPASS=GENERATE_STRONG_PASSWORD_HERE

# ============================================
# PORTS - Mail Server
# ============================================
# ⚠️ Ces ports doivent être libres sur votre serveur Coolify
SMTP_PORT=25
SMTPS_PORT=465
SUBMISSION_PORT=587
IMAP_PORT=143
IMAPS_PORT=993
POP_PORT=110
POPS_PORT=995

# Ports internes (ne pas exposer publiquement)
REDIS_PORT=127.0.0.1:26379
SQL_PORT=127.0.0.1:25432

# ============================================
# PORTS - Interface Web
# ============================================
HTTP_PORT=80
HTTPS_PORT=443

# ============================================
# TIMEZONE
# ============================================
# Liste: https://en.wikipedia.org/wiki/List_of_tz_database_time_zones
TZ=Europe/Paris

# ============================================
# RÉSEAU DOCKER
# ============================================
IPV4_NETWORK=172.66.1

# ============================================
# SÉCURITÉ
# ============================================
# Activer fail2ban (recommandé: y)
FAIL2BAN_INIT=y

# Liste blanche IP pour la console (true/false)
IP_WHITELIST_ENABLE=false

# Rétention des logs (jours)
RETENTION_DAYS=7
